# ============================================================
# .env.example — Referência de variáveis de ambiente
# ============================================================
# ATENÇÃO: Este arquivo contém APENAS os nomes das variáveis.
# NÃO preencha com valores reais.
# NÃO commite arquivos .env, .env.local ou .dev.vars.
#
# Para uso local:
#   1. Copie este arquivo: cp .env.example .env.local
#   2. Preencha os valores no .env.local (não commitado)
#   3. Para o Worker local: crie apps/worker/.dev.vars
#
# Para CI/CD (GitHub Actions):
#   Configure como GitHub Secrets em:
#   Settings > Secrets and variables > Actions
#
# Para Cloudflare Workers (secrets):
#   wrangler secret put NOME_DA_VARIAVEL
# ============================================================

# ------------------------------------------------------------
# Cloudflare — NÃO commitar valores reais
# ------------------------------------------------------------
# ID da conta Cloudflare (visível no painel — não é secret)
CLOUDFLARE_ACCOUNT_ID=

# Token de API com permissão Edit Workers (secret — nunca expor)
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------
# Cloudflare D1 — configurado em wrangler.toml após provisionamento
# ------------------------------------------------------------
# Gerado por: wrangler d1 create piedade-agenda-db
# Configurar em apps/worker/wrangler.toml (seção [[d1_databases]])
# database_id não é secret, mas não deve ser hardcoded em produção
D1_DATABASE_ID=

# ------------------------------------------------------------
# Aplicação (Worker) — copiar para apps/worker/.dev.vars
# ------------------------------------------------------------
APP_ENV=development
APP_VERSION=0.0.1-s00

# ------------------------------------------------------------
# Autenticação (Sprint S01+) — a definir com PMO
# Mecanismo: autenticação própria no Worker + D1 (ADR-001)
# NÃO implementar ainda
# ------------------------------------------------------------
# SESSION_SECRET=
# LINK_ATIVACAO_SECRET=
# PIN_PEPPER=
